{
  "entities": {
    "Paciente": {
      "title": "Paciente",
      "description": "Dados cadastrais, de endereço, médicos e plano de atendimento do paciente",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "dataNascimento": { "type": "string" },
        "cpf": { "type": "string" },
        "nomeResponsavel": { "type": "string" },
        "telefoneResponsavel": { "type": "string" },
        "email": { "type": "string" },
        "bairro": { "type": "string" },
        "status": { "type": "string", "enum": ["Ativo", "Desativado"] },
        "desativadoEm": { "type": "string" },
        "desativadoMotivo": { "type": "string" },
        "endereco": { "type": "object" },
        "informacoesMedicas": { "type": "object" },
        "planoAtendimento": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "nome", "cpf", "status"]
    },
    "Plantao": {
      "title": "Plantão",
      "description": "Informações dos plantões marcados e realizados",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "pacienteId": { "type": "string" },
        "data": { "type": "string" },
        "diaSemana": { "type": "string" },
        "profissional": { "type": "string" },
        "status": { "type": "string", "enum": ["Confirmado", "Cancelado"] },
        "motivoCancelamento": { "type": "string" },
        "tipoEscala": { "type": "number" },
        "dataInicio": { "type": "string" },
        "horaInicio": { "type": "string" },
        "dataTermino": { "type": "string" },
        "horaTermino": { "type": "string" },
        "observacaoAgendamento": { "type": "string" },
        "valorPlantao": { "type": "number" },
        "valorRepasse": { "type": "number" },
        "feriado": { "type": "string" },
        "ajudaCusto": { "type": "number" },
        "taxaAdm": { "type": "number" },
        "criadoEm": { "type": "string" },
        "criadoPor": { "type": "string" },
        "escalaCongelada": { "type": "boolean" }
      },
      "required": ["id", "pacienteId", "data", "status", "profissional"]
    },
    "DebitoProfissional": {
      "title": "Débito Profissional",
      "description": "Débitos e deduções financeiras lançadas para os profissionais/cuidadores",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "idProfissional": { "type": "string" },
        "nomeProfissional": { "type": "string" },
        "data": { "type": "object", "description": "Objeto Timestamp do Firestore" },
        "valor": { "type": "number" },
        "motivo": { "type": "string", "enum": ["Curinga", "Passagem", "Outros"] }
      },
      "required": ["idProfissional", "nomeProfissional", "data", "valor", "motivo"]
    },
    "BackupProntuario": {
      "title": "Backup Prontuário",
      "description": "Log de histórico de backups periódicos ou manuais contendo cópia integral dos prontuários de pacientes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "tipo": { "type": "string", "enum": ["Automático", "Manual"] },
        "itemsCount": { "type": "number" },
        "dadosPacientes": { "type": "string", "description": "String JSON comprimida com a listagem inteira de pacientes" },
        "usuarioExecutou": { "type": "string" }
      },
      "required": ["id", "timestamp", "tipo", "itemsCount", "dadosPacientes", "usuarioExecutou"]
    }
  },
  "firestore": {
    "/pacientes/{pacienteId}": {
      "schema": "Paciente",
      "description": "Coleção principal de pacientes"
    },
    "/plantoes/{plantaoId}": {
      "schema": "Plantao",
      "description": "Coleção de todos os plantões gerados e escalas executadas"
    },
    "/debitos_profissionais/{debitoId}": {
      "schema": "DebitoProfissional",
      "description": "Lista de ocorrências de débitos e deduções registradas para profissionais"
    },
    "/backups_prontuarios/{backupId}": {
      "schema": "BackupProntuario",
      "description": "Log e dados comprimidos de todos os backups realizados no prontuário"
    }
  }
}
