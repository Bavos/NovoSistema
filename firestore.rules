rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regra para faturas
    match /faturas/{faturaId} {
      allow read, write: if request.auth != null;
    }

    // Regra padrão para demais coleções autenticadas
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
