rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Verifica se o usuário está autenticado no Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Gestão de Usuários e Permissões do Sistema
    match /usuarios_sistema/{userId} {
      allow read, write: if isAuthenticated();
    }

    // 2. Prontuários e Dados Clínicos de Pacientes (inclui subcoleções e atualizações de prontuário)
    match /pacientes/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // 3. Profissionais e Ocorrências
    match /profissionais/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // 4. Escalas, Plantões e Agendamentos (incluindo operações em batch)
    match /plantoes/{document=**} {
      allow read, write: if isAuthenticated();
    }

    match /agendamentos/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // 5. Módulos Financeiros, Faturas, Folhas de Pagamento e Débitos
    match /faturas/{document=**} {
      allow read, write: if isAuthenticated();
    }

    match /faturas_pacientes/{document=**} {
      allow read, write: if isAuthenticated();
    }

    match /folhas_pagamento/{document=**} {
      allow read, write: if isAuthenticated();
    }

    match /debitos_profissionais/{document=**} {
      allow read, write: if isAuthenticated();
    }

    match /servicos_extras/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // 6. Configurações da Empresa e Dados Organizacionais
    match /configuracoes_empresa/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // 7. Backups de Prontuários
    match /backups_prontuarios/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // 8. Trilhas de Auditoria e Logs do Sistema (Imutabilidade de Histórico)
    match /logs_auditoria/{logId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false; // Logs são imutáveis
    }

    match /audit_logs/{logId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false; // Logs são imutáveis
    }

    match /LogsAuditoria/{logId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false; // Logs são imutáveis
    }

    match /system_errors/{errorId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }

    // 9. Rate Limiting de IA e Propostas de Ajustes
    match /rate_limits_ia/{uid} {
      // Manipulado exclusivamente via Cloud Functions com Admin SDK
      allow read, write: if false;
    }

    match /propostas_ajustes_ia/{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}

