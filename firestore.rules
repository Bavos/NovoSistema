rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net (catch-all default deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPaciente(p) {
      return p.id is string
        && p.nome is string && p.nome.size() <= 200
        && p.status is string && (p.status == 'Ativo' || p.status == 'Desativado');
    }

    function isValidPlantao(pl) {
      return pl.id is string
        && pl.pacienteId is string
        && pl.status is string && (pl.status == 'Confirmado' || pl.status == 'Cancelado');
    }

    match /test/{testId} {
      allow read, write: if true;
    }

    // Rule for Pacientes collection
    match /pacientes/{pacienteId} {
      allow read, delete: if isValidId(pacienteId) || true;
      allow create: if isValidId(pacienteId) && isValidPaciente(request.resource.data);
      allow update: if isValidId(pacienteId) && (
        // Allow updating planoAtendimento node freely
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['planoAtendimento']) ||
        isValidPaciente(request.resource.data) ||
        true
      );
    }

    // Rule for Plantoes collection
    match /plantoes/{plantaoId} {
      allow read, write, delete: if true;
    }
  }
}
